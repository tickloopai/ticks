# Build against a sibling Tickloop checkout instead of the commit pinned in Cargo.toml, for
# changes that span both repositories:
#
#   git clone https://github.com/tickloopai/tickloop ../tickloop
#   cp .cargo/config.toml.example .cargo/config.toml
#
# .cargo/config.toml is ignored by Git. Cargo.lock entries resolved through these paths are
# not valid for CI: delete .cargo/config.toml and run `cargo update` against the pinned
# commit before committing Cargo.lock. Release builds run in a fresh checkout and never read it.

[patch."https://github.com/tickloopai/tickloop"]
tickloop-tick-command = { path = "../tickloop/tick/command" }
tickloop-tick-market = { path = "../tickloop/tick/market" }
tickloop-tick-oauth = { path = "../tickloop/tick/oauth" }
tickloop-tick-packages = { path = "../tickloop/tick/packages" }
tickloop-tick-provider = { path = "../tickloop/tick/provider" }
tickloop-tick-sdk = { path = "../tickloop/tick/sdk" }
tickloop-tick-test-support = { path = "../tickloop/tick/test-support" }
tickloop-ui = { path = "../tickloop/ui" }

# Overrides the crossterm patch in Cargo.toml.
[patch.crates-io]
crossterm = { path = "../tickloop/vendor/crossterm" }
